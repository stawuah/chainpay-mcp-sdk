# Dedicated sandbox deployment only. Never source existing production .env files.
CHAINPAY_PAYPAL_ENABLED=false
CHAINPAY_PAYPAL_NEW_PURCHASES=false
CHAINPAY_PAYPAL_HOST=127.0.0.1
PORT=8081
CHAINPAY_PAYPAL_PUBLIC_ORIGIN=http://localhost:5173
CHAINPAY_PAYPAL_DATABASE_URL=postgresql://localhost/chainpay_paypal_development
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Dedicated OpenRouter key. Never reuse the existing application's AI environment.
CHAINPAY_PAYPAL_AI_KEY=
# Optional. Endpoint must be exactly the OpenRouter URL (default) or the Vercel
# AI Gateway URL https://ai-gateway.vercel.sh/v1/chat/completions; the key must
# belong to that provider. Model is one provider/model slug, [a-z0-9._-], ≤80.
CHAINPAY_PAYPAL_AI_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
CHAINPAY_PAYPAL_AI_MODEL=openai/gpt-5-mini
# Frontend only; public configuration, never provider secrets:
VITE_CHAINPAY_PAYPAL=false
VITE_CHAINPAY_PAYPAL_API_ORIGIN=http://localhost:8081

# Optional public AG Studio license issued for the judging period:
VITE_CHAINPAY_PAYPAL_STUDIO_LICENSE=

# Explicit sandbox plan, independently default off. Never falls back to Orders.
CHAINPAY_PAYPAL_SUBSCRIPTIONS=false
CHAINPAY_PAYPAL_SUBSCRIPTION_PLAN=

# Allowances (with new purchases on). Also gates refund credit and vault-token
# deletion on revoke.
CHAINPAY_PAYPAL_ALLOWANCES=false

# Wallet sign-in: POST /v1/paypal/session/wallet trades a ChainPay relay session
# for a buyer grant (workspace wallet:<address>, at most 12 hours). Off = 404.
CHAINPAY_PAYPAL_WALLET_LOGIN=false
# Relay origin, HTTPS (HTTP only on localhost). Required when wallet login is on.
CHAINPAY_PAYPAL_RELAY_URL=http://localhost:8787
# Extra browser origins allowed by CORS and the wallet bridge, comma-separated
# exact origins (HTTPS; HTTP only on localhost). Example: https://www.chainpayai.app
CHAINPAY_PAYPAL_EXTRA_ORIGINS=

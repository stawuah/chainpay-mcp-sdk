# Dedicated sandbox deployment only. Never source existing production .env files.
CHAINPAY_PAYPAL_ENABLED=false
CHAINPAY_PAYPAL_NEW_PURCHASES=false
CHAINPAY_PAYPAL_HOST=127.0.0.1
PORT=8081
CHAINPAY_PAYPAL_PUBLIC_ORIGIN=http://localhost:5173
CHAINPAY_PAYPAL_DATABASE_URL=postgresql://localhost/chainpay_paypal_development
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Dedicated OpenRouter key. Never reuse the existing application's AI environment.
CHAINPAY_PAYPAL_AI_KEY=
# Frontend only; public configuration, never provider secrets:
VITE_CHAINPAY_PAYPAL=false
VITE_CHAINPAY_PAYPAL_API_ORIGIN=http://localhost:8081

# Optional public AG Studio license issued for the judging period:
VITE_CHAINPAY_PAYPAL_STUDIO_LICENSE=

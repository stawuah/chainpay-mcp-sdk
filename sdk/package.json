{
  "name": "@chainpay/sdk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "bin": {
    "chainpay": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./known-assets": {
      "types": "./src/known-assets.ts",
      "import": "./dist/known-assets.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@solana/addresses": "^8.3.0",
    "@solana/instructions": "^8.3.0",
    "@solana/rpc-types": "^8.3.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/transaction-messages": "^8.3.0",
    "@solana/transactions": "^8.3.0",
    "@solana/web3.js": "^1.98.4"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}

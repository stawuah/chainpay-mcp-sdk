{
  "name": "@chainpay/frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test:dashboard-preview": "node test/dashboard-redesign.browser.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "test:permission-browser": "node test/permission-details.browser.mjs",
    "test:landing-browser": "node test/landing.browser.mjs",
    "test:landing-motion-browser": "node test/landing-motion.browser.mjs",
    "test:verify-public-browser": "node test/verify-public.browser.mjs",
    "test:dashboard-nav-browser": "node test/dashboard-nav.browser.mjs",
    "test:live-purchase-browser": "node test/live-purchase.browser.mjs",
    "test:record-details-scope-browser": "node test/record-details-scope.browser.mjs",
    "test:receipts-owner-browser": "node test/receipts-owner.browser.mjs",
    "test:permission-request-browser": "node test/permission-request.browser.mjs",
    "test:status-browser": "node test/status.browser.mjs",
    "test:browser": "npm run test:landing-browser && npm run test:landing-motion-browser && npm run test:permission-browser && npm run test:verify-public-browser && npm run test:dashboard-nav-browser && npm run test:live-purchase-browser && npm run test:record-details-scope-browser && npm run test:receipts-owner-browser && npm run test:permission-request-browser && npm run test:crossmint-browser && npm run test:pet-browser && npm run test:status-browser && npm run test:cards-browser && npm run test:dashboard-workspace",
    "test:crossmint-browser": "node test/crossmint-inbox.browser.mjs",
    "test:owner-onboarding-browser": "node test/owner-onboarding.browser.mjs",
    "test:dashboard-owner": "node test/dashboard-owner.browser.mjs",
    "test:pet-browser": "node test/pet.browser.mjs",
    "test:community-pet-browser": "node test/community-pet.browser.mjs && node test/community-review.browser.mjs",
    "test:dashboard-workspace": "node test/dashboard-workspace.browser.mjs",
    "test:cards-browser": "node test/cards.browser.mjs"
  },
  "dependencies": {
    "@astryxdesign/core": "0.6.1",
    "@astryxdesign/theme-neutral": "0.6.1",
    "@chainpay/sdk": "file:../sdk",
    "@phala/dcap-qvl": "0.6.5",
    "@react-three/fiber": "^9.8.1",
    "@solana/wallet-standard-features": "1.5.0",
    "@stylexjs/stylex": "^0.19.0",
    "@vercel/analytics": "^2.0.1",
    "@wallet-standard/app": "^1.1.1",
    "@wallet-standard/base": "^1.1.1",
    "@wallet-standard/features": "^1.1.1",
    "buffer": "^6.0.3",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "1.46.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.7",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.6.0",
    "esbuild": "^0.28.1",
    "jsdom": "^30.0.1",
    "playwright": "^1.63.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  },

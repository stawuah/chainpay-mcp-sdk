{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci --include=dev --ignore-scripts && cd .. && npm ci --include=dev --ignore-scripts",
  "buildCommand": "node ../scripts/check-release-env.mjs frontend && npm --prefix ../sdk run build && npm run build",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/((?!.*\\.[^/]+$).*)", "destination": "/index.html" }]
}

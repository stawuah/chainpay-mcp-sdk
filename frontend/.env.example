VITE_CHAINPAY_BACKEND_URL=https://chainpay-relay.vercel.app
VITE_CHAINPAY_RPC_URL=https://chainpay-relay.vercel.app/rpc
VITE_CHAINPAY_MCP_URL=https://chainpay-mcp.vercel.app/mcp
VITE_CHAINPAY_AGENT_URL=https://chainpay-mcp.vercel.app/agent/chat
# Optional Token-2022 mint override. When empty, the frontend discovers the
# enabled Devnet PYUSD mint from the on-chain ChainPay asset registry.
VITE_CHAINPAY_TOKEN_2022_MINT=
# Axum and MCP must allow this app's exact origin via CHAINPAY_ALLOWED_ORIGINS.
# Wallet session tokens stay in memory. Never add service credentials to VITE_*.
# Optional Devnet baseline receipt for local "See a receipt" demo (readonly verify).
# Do not set in production environment without confirming.
# VITE_CHAINPAY_DEMO_RECEIPT_PDA=7R1i9ccD7tZoXozceTMeTueWSfSs9F1jANQcCHcEsh2q

# Opt-in community robot and walletless /pet room. Requires matching Axum and
# Convex CHAINPAY_SHARED_PET=on; default leaves the legacy local pet in place.
VITE_CHAINPAY_SHARED_PET=off

# Crossmint checkout in Requests. Off unless exactly "true". Turn on only with
# the matching relay/MCP CHAINPAY_CROSSMINT_ENABLED and the release-manifest gates.
# VITE_CHAINPAY_CROSSMINT=false

# Agent cards (Lithic sandbox + card_policy on Devnet).
# card_policy program ID. Empty uses the Devnet default below.
# VITE_CHAINPAY_CARD_POLICY_PROGRAM_ID=H3aetJdQXG8EeJSCHZrpQa8iKHBw8e1p9fSPjTUsB93n
# Card face mark. Anything but "production" shows Sandbox; only the sandbox issuer exists today.
# VITE_CHAINPAY_CARD_ISSUER_ENV=sandbox
# Simulated credit partner's Devnet USDC token account. Statement repayment stays
# unavailable until it is set; if the relay serves one too, they must match.
# VITE_CHAINPAY_CARD_PARTNER_TOKEN_ACCOUNT=

# /support tips page (Devnet test tokens only). It stays "Opening soon" unless every
# value is set, well formed and says devnet. Leave unset: the splitter is not deployed.
# Open the page. Only exactly "true" counts.
# VITE_SUPPORT_LIVE=false
# Must be exactly "devnet"; anything else keeps the page closed.
# VITE_SUPPORT_CLUSTER=devnet
# Support splitter program ID from the authorized Devnet deploy.
# VITE_SUPPORT_PROGRAM_ID=
# The two recipient wallets from the signed setup comments.
# VITE_SUPPORT_RECIPIENT_A=
# VITE_SUPPORT_RECIPIENT_B=
# Convex HTTP route that serves indexed contributions (ends in /support/v1).
# VITE_SUPPORT_TRACKER_URL=
# Optional public, keyless Devnet RPC. Default: the Convex relay next to the tracker.
# VITE_SUPPORT_RPC_URL=

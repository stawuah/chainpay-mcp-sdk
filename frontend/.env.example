VITE_CHAINPAY_BACKEND_URL=https://chainpay-backend.onrender.com
VITE_CHAINPAY_RPC_URL=https://chainpay-backend.onrender.com/rpc
VITE_CHAINPAY_MCP_URL=https://chainpay-mcp.onrender.com/mcp
VITE_CHAINPAY_AGENT_URL=https://chainpay-mcp.onrender.com/agent/chat
# Optional Token-2022 mint override. When empty, the frontend discovers the
# enabled Devnet PYUSD mint from the on-chain ChainPay asset registry.
VITE_CHAINPAY_TOKEN_2022_MINT=
# Axum and MCP must allow this app's exact origin via CHAINPAY_ALLOWED_ORIGINS.
# Wallet session tokens stay in memory. Never add service credentials to VITE_*.
# Optional Devnet baseline receipt for local "See a receipt" demo (readonly verify).
# Do not set in production Render env without confirming.
# VITE_CHAINPAY_DEMO_RECEIPT_PDA=7R1i9ccD7tZoXozceTMeTueWSfSs9F1jANQcCHcEsh2q

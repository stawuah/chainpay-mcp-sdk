CHAINPAY_RPC_URL=https://api.devnet.solana.com
CHAINPAY_PROGRAM_ID=3H9TV1EPR2BAQgVmcMqpufiZKPXbAMnjHp13LA9Lndv4
CHAINPAY_BACKEND_URL=http://127.0.0.1:8080
CHAINPAY_BACKEND_AUTH_TOKEN=
DATABASE_URL=postgresql://chainpay:chainpay@127.0.0.1:5432/chainpay
CHAINPAY_HTTP_HOST=0.0.0.0
CHAINPAY_HTTP_PORT=3000
CHAINPAY_HTTP_PATH=/mcp
CHAINPAY_HTTP_AUTH_TOKEN=
CHAINPAY_ALLOWED_ORIGINS=http://localhost:5173
# Optional public identity for an approved-agent signer. In delegated mode this
# is the Privy-managed public address returned by Axum. Private keys and Privy
# credentials are never configured on or sent to the MCP server.
CHAINPAY_AGENT_PUBLIC_KEY=
OPENROUTER_API_KEY=
CHAINPAY_AI_PROVIDER=openrouter
# Optional; defaults to openrouter/free for OpenRouter.
CHAINPAY_AGENT_MODEL=openrouter/free
# Optional OpenAI fallback:
# OPENAI_API_KEY=
# Optional persistent merchant signer for signed Devnet demo invoices. Use a
# base64-encoded Solana 64-byte secret key or a JSON byte array. Never expose
# this value to the browser or an AI client.
CHAINPAY_DEMO_MERCHANT_SECRET_KEY=
# Defaults to the known Devnet PYUSD Token-2022 demo account below.
CHAINPAY_DEMO_MINT=CXk2AMBfi3TwaEL2468s6zP8xq9NxTXjp9gjMgzeUynM
CHAINPAY_DEMO_RECIPIENT=3JwwEZaFDMUNAoptGtg69qTB7MXYkZX7k8Anf3pAvZFY
CHAINPAY_DEMO_AMOUNT=1000000
# For private stdio calls only: an actual owner session or scoped connection.
# HTTP services forward the incoming caller token; do not set a global caller.
CHAINPAY_CALLER_TOKEN=
# Explicit trusted merchant origins for hosted outbound x402 requests.
CHAINPAY_X402_ALLOWED_ORIGINS=https://merchant.example.com
# Development only: loopback/localhost HTTP merchant exception.
CHAINPAY_X402_ALLOW_HTTP=false

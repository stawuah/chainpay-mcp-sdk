PORT=3402
# Interface the local server binds. Loopback by default; set 0.0.0.0 (or ::)
# only on a container or VM that must be reachable. Ignored on Vercel.
CHAINPAY_MERCHANT_HOST=127.0.0.1
CHAINPAY_RPC_URL=https://api.devnet.solana.com
CHAINPAY_PROGRAM_ID=3H9TV1EPR2BAQgVmcMqpufiZKPXbAMnjHp13LA9Lndv4
CHAINPAY_X402_RESOURCE_URL=http://127.0.0.1:3402/data
CHAINPAY_X402_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
CHAINPAY_X402_TOKEN_PROGRAM=spl-token
# Challenge shape: custom (x402/1.0, default) or v2 (standard x402 v2 document,
# still settled and proven with a ChainPay receipt PDA).
CHAINPAY_X402_CHALLENGE_SHAPE=custom
# Custom x402/1.0 payTo: recipient token account (not a merchant owner address).
# In v2 mode it must be the associated token account of
# CHAINPAY_X402_MERCHANT_OWNER for CHAINPAY_X402_MINT, and it must already exist.
CHAINPAY_X402_RECIPIENT_TOKEN_ACCOUNT=
# v2 payTo: the merchant's wallet address. Required when
# CHAINPAY_X402_CHALLENGE_SHAPE=v2; startup fails without it. Never the agent.
CHAINPAY_X402_MERCHANT_OWNER=
CHAINPAY_X402_ALLOWED_AGENT=
CHAINPAY_X402_AMOUNT=100000
# Optional stable challenge nonce. When omitted, SDK derives it deterministically.
CHAINPAY_X402_NONCE=
# Optional PR-07 seller attestation. Requires both a host-only Ed25519 key and
# CHAINPAY_BACKEND_URL. Leave either unset: Paid responses are not attested
# and this process does not call Axum. Never commit a live secret. The public
# key derived from the secret must match Axum CHAINPAY_TRUSTED_SELLER.
# Tests use the SDK 32-byte 0x07 fixture seed, not a live merchant key.
# CHAINPAY_BACKEND_URL=http://127.0.0.1:8080
# CHAINPAY_SELLER_SECRET_KEY=
# CHAINPAY_TRUSTED_SELLER=
